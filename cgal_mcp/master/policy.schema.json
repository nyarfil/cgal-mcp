{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgal.org/cgal-master/policy.schema.json",
  "type": "object",
  "required": ["schema_version", "cgal_version", "build_requirements", "operation_requirements", "policies"],
  "properties": {
    "schema_version": {"const": 1},
    "cgal_version": {"type": "string"},
    "build_requirements": {"type": "object", "required": ["source_kind", "source_sha256"]},
    "operation_requirements": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}},
    "policies": {"type": "array", "items": {"type": "object", "required": ["id", "revision", "operation", "group", "name", "status", "summary", "selectors", "implementation", "evidence"]}}
  }
}
