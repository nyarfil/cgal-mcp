# Evidence under docs/master/evidence binds the SHA-256 of source, catalog and guide files as
# they are on disk. Every text file is therefore checked out with LF on every platform; with
# CRLF conversion the digests differ between Windows and Linux checkouts.
* text=auto eol=lf
# Preserve the user-supplied design documents byte-for-byte in Git.
docs/master/CGAL_Master_MCP_Design_Spec.md -text
docs/master/CGAL_Master_MCP_Implementation_Plan.md -text
catalog/** text eol=lf
cgal_mcp/master/catalog/** text eol=lf
tests/fixtures/master/** text eol=lf
docs/master/evidence/** text eol=lf
